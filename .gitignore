# ==========================================
# macOS
# ==========================================
.DS_Store
.AppleDouble
.LSOverride
._*

# ==========================================
# JetBrains / RubyMine
# ==========================================
.idea/
*.iml
*.ipr
*.iws

# ==========================================
# Ruby / Bundler
# ==========================================
*.gem
.bundle/
vendor/bundle/
vendor/cache/
.ruby-lsp/

# ==========================================
# Rails runtime files
# ==========================================
**/log/*
!**/log/.keep

**/tmp/*
!**/tmp/.keep

**/storage/*
!**/storage/.keep

**/public/assets/
**/public/packs/
**/public/packs-test/

# ==========================================
# Rails credentials and secrets
# ==========================================
**/config/master.key
**/config/credentials/*.key
**/config/credentials/*.yml.enc.key

.env
.env.*
**/.env
**/.env.*
!.env.example
!**/.env.example

# ==========================================
# Database files and dumps
# ==========================================
*.sqlite3
*.sqlite3-*
*.sql.gz
*.dump
*.backup

# ==========================================
# RSpec / Test coverage
# ==========================================
**/coverage/
**/spec/examples.txt
**/test/reports/
**/tmp/screenshots/
.rspec_status

# ==========================================
# Node.js / React / Vite
# ==========================================
node_modules/
**/node_modules/
**/dist/
**/.vite/
**/.cache/
**/.next/
**/.turbo/

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==========================================
# TypeScript
# ==========================================
*.tsbuildinfo

# ==========================================
# Local tooling
# ==========================================
.vscode/
*.swp
*.swo
*~
